---
import { render } from "astro:content";

import Base from "../../layouts/Base.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import { publishedLinks } from "../../lib/content";

const links = await Promise.all(
  (await publishedLinks()).map(async (link) => ({
    ...link,
    Content: (await render(link)).Content,
  })),
);
---

<Base
  title="Links"
  description="Other people's work worth your time, with a note on why."
>
  <h1>Links</h1>
  <p class="lede">
    Other people's work worth your time, each with a line on why. Sources are
    always named.
  </p>

  <ul class="feed">
    {
      links.map(({ Content, data }) => (
        <li>
          <a class="entry__title" href={data.url}>
            {data.title}
          </a>
          <div class="note-body entry__desc">
            <Content />
          </div>
          <div class="tagrow">
            <FormattedDate date={data.pubDate} />
            {data.source && (
              <>
                <span>·</span>
                <span>{data.source}</span>
              </>
            )}
          </div>
        </li>
      ))
    }
  </ul>
</Base>
