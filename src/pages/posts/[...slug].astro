---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";

import Base from "../../layouts/Base.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import { SERIES } from "../../consts";
import { publishedPosts } from "../../lib/content";

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await publishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
};

const { post } = Astro.props;
const { Content } = await render(post);
const series = SERIES[post.data.series];
---

<Base
  title={post.data.title}
  description={post.data.description}
  ogType="article"
>
  <article>
    <header>
      <h1>{post.data.title}</h1>
      <div class="tagrow" style="margin-bottom:2.5rem">
        <FormattedDate date={post.data.pubDate} />
        {
          post.data.updatedDate && (
            <>
              <span>·</span>
              <span>
                updated <FormattedDate date={post.data.updatedDate} />
              </span>
            </>
          )
        }
        <span>·</span>
        <a class="series-tag" href={`/series/${post.data.series}/`}>
          {series.name}
        </a>
        {post.data.draft && <span class="draft-flag">draft</span>}
      </div>
    </header>

    <div class="article__body">
      <Content />
    </div>
  </article>

  <hr />

  <p class="meta">
    Filed under <a href={`/series/${post.data.series}/`}>{series.name}</a>.
    {post.data.tags.length > 0 && <span>Tags: {post.data.tags.join(", ")}.</span>}
  </p>
</Base>
