---
import Base from "../../layouts/Base.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import { SERIES, SERIES_IDS } from "../../consts";
import { publishedPosts } from "../../lib/content";

const posts = await publishedPosts();
---

<Base
  title="Posts"
  description="Long-form writing on robotics engineering, the Chinese hardware industry, and control systems."
>
  <h1>Posts</h1>
  <p class="lede">
    Long-form writing, filed under one of three series. Subscribe to <a
      href="/posts/rss.xml">the long-form feed</a
    > if you only want these and not the short stuff.
  </p>

  <section>
    <h2>Series</h2>
    <ul class="feed">
      {
        SERIES_IDS.map((id) => (
          <li>
            <a class="entry__title" href={`/series/${id}/`}>
              {SERIES[id].name}
            </a>
            <p class="entry__desc">{SERIES[id].blurb}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section>
    <h2>All posts</h2>
    <ul class="feed">
      {
        posts.map((post) => (
          <li>
            <a class="entry__title" href={`/posts/${post.id}/`}>
              {post.data.title}
            </a>
            <p class="entry__desc">{post.data.description}</p>
            <div class="tagrow">
              <FormattedDate date={post.data.pubDate} />
              <span>·</span>
              <a class="series-tag" href={`/series/${post.data.series}/`}>
                {SERIES[post.data.series].name}
              </a>
              {post.data.draft && <span class="draft-flag">draft</span>}
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
